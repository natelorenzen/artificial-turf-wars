# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — the example is committed and documents every required var
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Regenerable Sleeper responses cached by tools/*.py. The two files below are real
# test fixtures (src/lib/sleeper/normalize.test.ts) and stay committed so the
# calibration tests do not depend on whether the cache happens to be warm.
tools/.cache/*
!tools/.cache/act_2025_DEF.json
!tools/.cache/act_2025_K.json

# Chalk or Walk transcripts — evidence for a run, not source
debate-runs/

# A scratch file for pasting X credentials into. Never committed.
PASTE-X-KEYS-HERE.txt
