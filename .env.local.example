# Gridiron Gauntlet — copy to .env.local and fill in. .env.local is gitignored.

# --- Supabase -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_ — it would ship in the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenRouter -----------------------------------------------------------
# One key covers all eight competitors plus the non-competing beat writer.
OPENROUTER_API_KEY=
# Sent as HTTP-Referer / X-Title on every call so usage is attributable.
OPENROUTER_SITE_URL=https://gridirongauntlet.example
OPENROUTER_APP_NAME=Gridiron Gauntlet

# --- Cron auth ------------------------------------------------------------
# Every /api/cron/* route checks Authorization: Bearer $CRON_SECRET.
CRON_SECRET=

# --- Season control -------------------------------------------------------
SEASON_YEAR=2026
# sha256 of the draft seed, published before the auction. The raw seed lives in
# DRAFT_SEED and is revealed publicly after the auction resolves (SPEC §8.3).
DRAFT_SEED=
DRAFT_SEED_COMMIT_HASH=

# Set to 1 to allow destructive/irreversible jobs (auction, draft) to actually run.
# Every one-shot job refuses without it (SPEC §4.2, §4.3).
ALLOW_IRREVERSIBLE=0

# --- X (posting as @PlayATW) ----------------------------------------------
# All four are required. `POST /2/tweets` needs a USER context: the request is
# signed with `consumer_secret & access_token_secret`, and the access token is
# the only part that names an account. The API key alone signs nothing and posts
# as nobody. The portal's Bearer token is app-only auth and CANNOT post — it is
# deliberately not listed here.
#
# Order matters when generating these. Set app permissions to "Read and write"
# FIRST, then regenerate the access token: a token minted before the change keeps
# its read-only scope, and the 403 it returns does not mention permissions.
#
# The token belongs to whichever account was signed in when it was generated, and
# that account is the byline on every post for the season. Check with:
#   npx tsx --env-file=.env.local scripts/x-check.ts
#
# Absent, /api/cron/social still composes and queues drafts — it just reports a
# skip instead of sending. Nothing breaks while these are being set up.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- Site / analytics ------------------------------------------------------
# The canonical origin, used for metadata and OG tags.
NEXT_PUBLIC_SITE_URL=https://www.artificialturfwar.com
# Google Analytics 4 measurement id. Public by design — it ships in the page
# source of every site using GA. Analytics render only when this is set, so
# local and preview builds never pollute the numbers.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
